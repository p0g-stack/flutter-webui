From bca208c2f894b535432c774d14e53f6c3e2e5086 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 1 Oct 2026 05:35:35 +0000
Subject: [PATCH 5/5] [web] Clipboard: use the host's clipboard when it
 supplies one

---
 .../lib/web_ui/lib/src/engine/clipboard.dart  | 26 +++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/engine/src/flutter/lib/web_ui/lib/src/engine/clipboard.dart b/engine/src/flutter/lib/web_ui/lib/src/engine/clipboard.dart
index 58e816545ba..1b5098b58f1 100644
--- a/engine/src/flutter/lib/web_ui/lib/src/engine/clipboard.dart
+++ b/engine/src/flutter/lib/web_ui/lib/src/engine/clipboard.dart
@@ -5,7 +5,10 @@
 import 'package:meta/meta.dart';
 import 'package:ui/ui.dart' as ui;
 
+import 'package:ui/ui_web/src/ui_web.dart' as ui_web;
+
 import 'dom.dart';
+import 'host_embedding.dart';
 import 'services.dart';
 
 /// Handles clipboard related platform messages.
@@ -15,7 +18,13 @@ class ClipboardMessageHandler {
   static const String kTextPlainFormat = 'text/plain';
 
   /// Helper to handle clipboard functionality.
-  ClipboardStrategy _clipboardStrategy = ClipboardStrategy();
+  ClipboardStrategy _browserClipboardStrategy = ClipboardStrategy();
+
+  /// The host's clipboard when it supplies one, else the browser's.
+  ClipboardStrategy get _clipboardStrategy {
+    final ui_web.HostClipboard? host = HostEmbedding.instance.clipboard;
+    return host == null ? _browserClipboardStrategy : _HostClipboardStrategy(host);
+  }
 
   /// Handles the platform message which copies the given text to the clipboard.
   void setDataMethodCall(ui.PlatformMessageResponseCallback? callback, String? text) {
@@ -75,7 +84,7 @@ class ClipboardMessageHandler {
   /// Overrides the default clipboard strategy.
   @visibleForTesting
   set clipboardStrategy(ClipboardStrategy strategy) {
-    _clipboardStrategy = strategy;
+    _browserClipboardStrategy = strategy;
   }
 }
 
@@ -108,3 +117,16 @@ class ClipboardStrategy {
     return _clipboard.readText();
   }
 }
+
+/// Adapts a [ui_web.HostClipboard] to the handler's strategy.
+class _HostClipboardStrategy extends ClipboardStrategy {
+  _HostClipboardStrategy(this._host);
+
+  final ui_web.HostClipboard _host;
+
+  @override
+  Future<void> setData(String? text) => _host.setText(text ?? '');
+
+  @override
+  Future<String> getData() async => await _host.getText() ?? '';
+}
-- 
