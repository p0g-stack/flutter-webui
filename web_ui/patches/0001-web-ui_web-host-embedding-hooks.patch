+import 'dart:async';
+
+import 'package:ui/ui.dart' as ui;
+import 'package:ui/ui_web/src/ui_web.dart' as ui_web;
+
+/// What the page cannot learn from the browser when an app embeds it in a
+/// WebView (for example a root manager's module WebUI), supplied by that
+/// embedding. Every value is null in a plain browser tab, and null means "use
+/// what the browser reports".
+class HostEmbedding {
+  HostEmbedding._();
+
+  static final HostEmbedding instance = HostEmbedding._();
+
+  final StreamController<void> _metrics = StreamController<void>.broadcast(sync: true);
+  final StreamController<void> _lifecycle = StreamController<void>.broadcast(sync: true);
+  final StreamController<void> _brightness = StreamController<void>.broadcast(sync: true);
+
+  /// Fires when [viewPadding] or [keyboardInset] change.
+  Stream<void> get onMetricsChanged => _metrics.stream;
+
+  /// Fires when [appLifecycleState] changes.
+  Stream<void> get onAppLifecycleStateChanged => _lifecycle.stream;
+
+  /// Fires when [platformBrightness] changes.
+  Stream<void> get onPlatformBrightnessChanged => _brightness.stream;
+
+  /// Safe-area padding the host draws over (status and navigation bars,
+  /// cutouts), in logical pixels.
+  ui_web.HostInsets? get viewPadding => _viewPadding;
+  ui_web.HostInsets? _viewPadding;
+  set viewPadding(ui_web.HostInsets? value) {
+    if (value == _viewPadding) {
+      return;
+    }
+    _viewPadding = value;
+    _metrics.add(null);
+  }
+
+  /// Height of the on-screen keyboard as the host reports it, in logical
+  /// pixels.
+  double? get keyboardInset => _keyboardInset;
+  double? _keyboardInset;
+  set keyboardInset(double? value) {
+    if (value == _keyboardInset) {
+      return;
+    }
+    _keyboardInset = value;
+    _metrics.add(null);
+  }
+
+  /// The lifecycle state the host reports where the page's visibility does not
+  /// follow it (a WebView kept `visible` while its app is in the background).
+  ui.AppLifecycleState? get appLifecycleState => _appLifecycleState;
+  ui.AppLifecycleState? _appLifecycleState;
+  set appLifecycleState(ui.AppLifecycleState? value) {
+    if (value == _appLifecycleState) {
+      return;
+    }
+    _appLifecycleState = value;
+    _lifecycle.add(null);
+  }
+
+  /// The host's light or dark mode, where `prefers-color-scheme` does not
+  /// follow it.
+  ui.Brightness? get platformBrightness => _platformBrightness;
+  ui.Brightness? _platformBrightness;
+  set platformBrightness(ui.Brightness? value) {
+    if (value == _platformBrightness) {
+      return;
+    }
+    _platformBrightness = value;
+    _brightness.add(null);
+  }
+
+  /// Closes the page after `SystemNavigator.pop` has unwound browser history,
+  /// as closing the tab would.
+  Future<void> Function()? exitHandler;
+
+  /// Clipboard used instead of `navigator.clipboard`.
+  ui_web.HostClipboard? clipboard;
+}
