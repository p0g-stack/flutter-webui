+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import 'package:ui/src/engine.dart';
+import 'package:ui/ui.dart' as ui;
+
+/// Insets in logical pixels (CSS pixels).
+class HostInsets {
+  const HostInsets({this.left = 0, this.top = 0, this.right = 0, this.bottom = 0});
+
+  final double left;
+  final double top;
+  final double right;
+  final double bottom;
+
+  @override
+  bool operator ==(Object other) =>
+      other is HostInsets &&
+      other.left == left &&
+      other.top == top &&
+      other.right == right &&
+      other.bottom == bottom;
+
+  @override
+  int get hashCode => Object.hash(left, top, right, bottom);
+
+  @override
+  String toString() => 'HostInsets($left, $top, $right, $bottom)';
+}
+
+/// Text clipboard supplied by a host where `navigator.clipboard` is missing or
+/// refused.
+abstract class HostClipboard {
+  Future<String?> getText();
+  Future<void> setText(String text);
+}
+
+/// Sets the safe-area padding the embedding host draws over, in logical
+/// pixels, or null to use the browser's (always zero).
+///
+/// For pages embedded in an app's WebView. A browser tab never calls this.
+void setHostViewPadding(HostInsets? padding) {
+  HostEmbedding.instance.viewPadding = padding;
+}
+
+/// Sets the on-screen keyboard height the host reports, in logical pixels, or
+/// null to measure it from the visual viewport.
+void setHostKeyboardInset(double? bottom) {
+  HostEmbedding.instance.keyboardInset = bottom;
+}
+
+/// Sets the lifecycle state the host reports, or null to follow the page's
+/// visibility and focus.
+///
+/// For hosts that keep the page `visible` while their app is in the
+/// background: report [ui.AppLifecycleState.hidden] on pause and null on
+/// resume.
+void setHostAppLifecycleState(ui.AppLifecycleState? state) {
+  HostEmbedding.instance.appLifecycleState = state;
+}
+
+/// Sets the host's light or dark mode, or null to follow
+/// `prefers-color-scheme`.
+void setHostPlatformBrightness(ui.Brightness? brightness) {
+  HostEmbedding.instance.platformBrightness = brightness;
+}
+
+/// Sets what closes the page when the app pops its last route
+/// (`SystemNavigator.pop`), after browser history has been unwound.
+void setHostExitHandler(Future<void> Function()? handler) {
+  HostEmbedding.instance.exitHandler = handler;
+}
+
+/// Sets a clipboard to use instead of `navigator.clipboard`, or null.
+void setHostClipboard(HostClipboard? clipboard) {
+  HostEmbedding.instance.clipboard = clipboard;
+}
